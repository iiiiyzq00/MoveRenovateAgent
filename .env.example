# ═══════════════════════════════════════════════════════════
# MoveRenovateAgent — 环境变量模板
# 复制此文件为 .env 并填入实际值
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════

# ── 应用 ─────────────────────────────────────────────────
APP_NAME=MoveRenovateAgent
DEBUG=true
LOG_LEVEL=INFO

# ── 数据库 ───────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=mra
POSTGRES_PASSWORD=mra_secret
POSTGRES_DB=move_renovate

# ── Redis ────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── ChromaDB ─────────────────────────────────────────────
CHROMADB_HOST=localhost
CHROMADB_PORT=8001

# ── LLM ──────────────────────────────────────────────────
# 支持: openai / deepseek / anthropic
LLM_PROVIDER=deepseek
LLM_API_KEY=your_deepseek_api_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# Embedding: openai | local_bge | chroma_default
# local_bge = BAAI/bge-large-zh 本地中文模型 (~1.3GB首次下载)
EMBEDDING_PROVIDER=chroma_default
EMBEDDING_API_KEY=your_openai_api_key_here
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small

# ── MCP 工具 ─────────────────────────────────────────────
# 高德地图 API Key (https://lbs.amap.com/)
AMAP_API_KEY=your_amap_api_key_here
# 货拉拉开放平台 (https://developers.lalamove.com/) — 需企业认证
LALAMOVE_API_KEY=
LALAMOVE_API_SECRET=

# ── 其他 ─────────────────────────────────────────────────
SKILLS_DIR=./skills
SKILL_WATCH_ENABLED=true
